{
  "name": "@frontic/ui",
  "version": "0.15.0",
  "description": "Install Frontic UI items and build their look from your library",
  "type": "module",
  "bin": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tailwind.css": "./src/tailwind.css"
  },
  "files": [
    "dist",
    "src/tailwind.css",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "schema": "WRITE_SCHEMA=1 vitest run tests/unit/config-json-schema.test.ts && cd ../.. && oxfmt packages/registry/public/schema.json"
  },
  "dependencies": {
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@typescript-eslint/parser": "8.72.0",
    "@unovue/detypes": "^0.8.5",
    "astro-eslint-parser": "3.2.0",
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "deepmerge": "^4.3.1",
    "diff": "^9.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "fs-extra": "^11.4.1",
    "fuzzysort": "^4.0.2",
    "get-tsconfig": "^4.14.3",
    "jsonc-eslint-parser": "3.3.0",
    "nypm": "^0.6.11",
    "ora": "^9.4.1",
    "pathe": "^2.0.3",
    "prompts": "^2.4.2",
    "semver": "^7.8.5",
    "tailwindcss": "4.3.3",
    "tinyexec": "^1.3.1",
    "tinyglobby": "^0.2.17",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "validate-npm-package-name": "^8.0.0",
    "vue-eslint-parser": "10.4.1",
    "vue-metamorph": "^4.1.0",
    "yaml-eslint-parser": "2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@frontic/library-contract": "workspace:*",
    "@frontic/registry-client": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.19.2",
    "@types/prompts": "^2.4.9",
    "@types/semver": "^7.8.0",
    "tsdown": "^0.23.2",
    "type-fest": "^5.10.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://ui.frontic.com",
  "keywords": [
    "vue",
    "nuxt",
    "components",
    "ui",
    "shadcn",
    "shadcn-vue",
    "frontic",
    "frontic-ui",
    "tailwind",
    "radix-ui",
    "radix-vue",
    "reka-ui",
    "cli"
  ],
  "author": "Frontic",
  "license": "FSL-1.1-MIT",
  "engines": {
    "node": ">=22.22.2"
  }
}
