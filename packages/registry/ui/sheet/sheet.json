{
  "$schema": "../../item.schema.json",
  "title": "Sheet",
  "description": "Slides a panel in from a screen edge over the page, with a header, a scrolling body and a footer, for carts, filters and menus.",
  "recipes": {
    "sheet-body": {
      "base": {
        "minHeight": "{spacing.0}",
        "paddingX": "{spacing.8}"
      }
    },
    "sheet-content": {
      "base": {
        "extends": "overlay-sheet",
        "display": "flex",
        "flexDirection": "column"
      },
      "variants": {
        "side": {
          "top": {
            "borderBottom": "{border.default}"
          },
          "right": {
            "borderLeft": "{border.default}",
            "width": "{spacing.96}"
          },
          "bottom": {
            "borderTop": "{border.default}"
          },
          "left": {
            "borderRight": "{border.default}",
            "width": "{spacing.96}"
          },
          "start": {
            "borderEnd": "{border.default}",
            "width": "{spacing.96}"
          },
          "end": {
            "borderStart": "{border.default}",
            "width": "{spacing.96}"
          }
        }
      },
      "defaults": {
        "side": "end"
      }
    },
    "sheet-description": {
      "base": {
        "marginTop": "{spacing.0.5}",
        "extends": "part-description"
      }
    },
    "sheet-footer": {
      "base": {
        "marginTop": "auto",
        "display": "flex",
        "flexDirection": "column",
        "gap": "{spacing.2}",
        "padding": "{spacing.8}"
      }
    },
    "sheet-header": {
      "base": {
        "display": "flex",
        "flexDirection": "column",
        "gap": "{spacing.1.5}",
        "padding": "{spacing.8}"
      }
    },
    "sheet-overlay": {
      "base": {
        "extends": "overlay-backdrop"
      }
    },
    "sheet-title": {
      "base": {
        "extends": "part-title"
      }
    }
  }
}
