{
  "$schema": "../../item.schema.json",
  "title": "Kbd",
  "description": "Shows a keyboard key or shortcut, such as the key that focuses the search.",
  "components": {
    "Kbd": "Shows a keyboard key or shortcut.",
    "KbdGroup": "Groups several keys into one shortcut."
  },
  "recipes": {
    "kbd": {
      "base": {
        "backgroundColor": "{colors.muted}",
        "textColor": "{colors.muted-foreground}",
        "rounded": "{rounded.none}",
        "typography": "{typography.caption}",
        "height": "{spacing.5.5}",
        "minWidth": "{spacing.5.5}",
        "paddingX": "{spacing.1.5}",
        "gap": "{spacing.1}",
        "display": "inline-flex",
        "width": "fit",
        "alignItems": "center",
        "justifyContent": "center",
        "icon": {
          "size": "{spacing.3}"
        }
      }
    },
    "kbd-group": {
      "base": {
        "display": "inline-flex",
        "alignItems": "center",
        "gap": "{spacing.1}"
      }
    }
  }
}
