{
  "$schema": "../../item.schema.json",
  "title": "Stepper",
  "description": "Numbered steps through a flow such as checkout, marking done, current and upcoming, joined by a line that fills as each step is done; spans its row, and on a narrow screen names only the current step.",
  "components": {
    "Stepper": "Groups all parts of the stepper, which guides the user through a sequence of steps.",
    "StepperDescription": "Explains in a short line what happens in a step.",
    "StepperIndicator": "Marks the number or progress state of a step.",
    "StepperItem": "Groups the trigger, title and description of one step in the stepper.",
    "StepperSeparator": "Joins one step of the stepper to the next with a line that fills once the step is done.",
    "StepperTitle": "Names a step of the stepper.",
    "StepperTrigger": "Lets the user jump to its step."
  },
  "recipes": {
    "stepper": {
      "base": {
        "display": "flex",
        "flexWrap": "wrap"
      }
    },
    "stepper-description": {
      "base": {
        "textColor": "{colors.muted-foreground}",
        "typography": "{typography.caption}",
        "fontWeight": "normal"
      }
    },
    "stepper-indicator": {
      "base": {
        "rounded": "{rounded.full}",
        "size": "{spacing.8}",
        "display": "inline-flex",
        "alignItems": "center",
        "justifyContent": "center",
        "icon": {
          "size": "{spacing.4}"
        }
      },
      "variants": {
        "state": {
          "inactive": {
            "backgroundColor": "{colors.background}",
            "textColor": "{colors.muted-foreground}",
            "border": "{border.default}",
            "borderColor": "{colors.input}"
          },
          "active": {
            "backgroundColor": "{colors.primary}",
            "textColor": "{colors.primary-foreground}"
          },
          "completed": {
            "backgroundColor": "{colors.foreground}",
            "textColor": "{colors.background}"
          }
        }
      },
      "defaults": {
        "state": "inactive"
      }
    },
    "stepper-item": {
      "base": {
        "display": "flex",
        "alignItems": "center"
      }
    },
    "stepper-separator": {
      "base": {
        "extends": "divider"
      }
    },
    "stepper-separator-fill": {
      "base": {
        "backgroundColor": "{colors.foreground}"
      }
    },
    "stepper-separator-root": {
      "base": {
        "marginX": "{spacing.1}",
        "height": "{spacing.px}",
        "flex": "1"
      }
    },
    "stepper-status": {
      "base": {
        "textColor": "{colors.muted-foreground}",
        "typography": "{typography.caption}"
      }
    },
    "stepper-title": {
      "base": {
        "typography": "{typography.ui}",
        "fontWeight": "medium"
      },
      "variants": {
        "state": {
          "inactive": {
            "textColor": "{colors.muted-foreground}"
          },
          "active": {
            "fontWeight": "semibold"
          },
          "completed": {}
        }
      },
      "defaults": {
        "state": "inactive"
      }
    },
    "stepper-trigger": {
      "composes": ["focus-ring"],
      "base": {
        "rounded": "{rounded.none}",
        "gap": "{spacing.2}",
        "padding": "{spacing.1}",
        "display": "flex",
        "flexDirection": "column",
        "alignItems": "center",
        "textAlign": "center"
      }
    }
  }
}
