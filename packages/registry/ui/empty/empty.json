{
  "$schema": "../../item.schema.json",
  "title": "Empty",
  "description": "Fills the space when there is nothing to show, such as an empty cart or a search without results, with an icon, a title, a hint and actions.",
  "components": {
    "Empty": "Groups all parts of the empty state.",
    "EmptyContent": "Holds the actions offered to the user when there is nothing to show.",
    "EmptyDescription": "Explains why there is nothing to show and what to do next.",
    "EmptyHeader": "Groups the media, title and description of the empty state.",
    "EmptyMedia": "Shows an icon or image above the title of the empty state.",
    "EmptyTitle": "States that there is nothing to show."
  },
  "recipes": {
    "empty": {
      "base": {
        "rounded": "{rounded.none}",
        "gap": "{spacing.4}",
        "padding": "{spacing.6}",
        "display": "flex",
        "width": "full",
        "minWidth": "{spacing.0}",
        "flex": "1",
        "flexDirection": "column",
        "alignItems": "center",
        "justifyContent": "center",
        "textAlign": "center",
        "@md": {
          "padding": "{spacing.12}"
        }
      }
    },
    "empty-content": {
      "base": {
        "typography": "{typography.small}",
        "gap": "{spacing.4}",
        "display": "flex",
        "width": "full",
        "maxWidth": "{container.sm}",
        "minWidth": "{spacing.0}",
        "flexDirection": "column",
        "alignItems": "center"
      }
    },
    "empty-description": {
      "base": {
        "marginTop": "{spacing.0.5}",
        "extends": ["part-description", "link-primary"],
        "lineHeight": "relaxed"
      }
    },
    "empty-header": {
      "base": {
        "display": "flex",
        "maxWidth": "{container.sm}",
        "flexDirection": "column",
        "alignItems": "center",
        "gap": "{spacing.2}"
      }
    },
    "empty-media": {
      "base": {
        "rounded": "{rounded.none}",
        "marginBottom": "{spacing.2}",
        "display": "flex",
        "flexShrink": "0",
        "alignItems": "center",
        "justifyContent": "center"
      },
      "variants": {
        "variant": {
          "default": {
            "backgroundColor": "transparent"
          },
          "icon": {
            "backgroundColor": "{colors.muted}",
            "textColor": "{colors.foreground}",
            "size": "{spacing.10}",
            "icon": {
              "size": "{spacing.5}"
            }
          }
        }
      },
      "defaults": {
        "variant": "default"
      }
    },
    "empty-title": {
      "base": {
        "extends": "part-title-lg"
      }
    }
  }
}
