    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "The pill call to action: primary for the one action a view asks for, inverse on photography, ghost as a text link.",
      "files": [
        {
          "path": "components/ui/button/Button.vue",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/button/index.ts",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/button/button.example.vue",
          "type": "registry:example"
        }
      ],
      "meta": {
        "frontic": {
          "props": [
            {
              "name": "variant",
              "kind": "style",
              "type": "\"primary\" | \"secondary\" | \"outline\" | \"inverse\" | \"ghost\" | null | undefined",
              "required": false,
              "default": "\"primary\"",
              "values": ["primary", "secondary", "outline", "inverse", "ghost"]
            },
            {
              "name": "size",
              "kind": "style",
              "type": "\"default\" | \"sm\" | \"bare\" | null | undefined",
              "required": false,
              "default": "\"default\"",
              "values": ["default", "sm", "bare"]
