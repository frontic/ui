{
  "name": "@frontic/registry",
  "version": "0.0.1",
  "private": true,
  "description": "Frontic UI component registry",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "serve": "npx serve public -l 3333",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "contract": "tsx scripts/contract.ts",
    "licence": "tsx scripts/licence-lines.ts",
    "look": "tsx scripts/look-check.ts",
    "clean": "rm -rf dist public/v1",
    "publish:cf": "pnpm build && wrangler pages deploy public --project-name=frontic-registry --branch=main --commit-dirty=true",
    "publish:cf:preview": "pnpm build && wrangler pages deploy public --project-name=frontic-registry --branch=preview --commit-dirty=true"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@internationalized/number": "^3.6.9",
    "@lucide/vue": "1.52.0",
    "@standard-schema/spec": "^1.1.0",
    "@vueuse/core": "^15.0.0",
    "card-validator": "^10.0.4",
    "class-variance-authority": "^0.7.1",
    "credit-card-type": "^10.3.1",
    "embla-carousel-vue": "9.0.0-rc04",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44",
    "vue-input-otp": "^0.4.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@frontic/library-contract": "workspace:*",
    "@frontic/registry-client": "workspace:*",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/vue": "1.0.8",
    "@phosphor-icons/vue": "2.2.1",
    "@remixicon/vue": "4.9.0",
    "@tabler/icons-vue": "3.48.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "ajv": "8.20.0",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "happy-dom": "21.0.3",
    "oxfmt": "^0.74.0",
    "serve": "^14.2.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.5",
    "vue-component-meta": "3.3.13",
    "vue-metamorph": "4.1.0",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frontic/ui.git",
    "directory": "packages/registry"
  },
  "author": "Frontic",
  "license": "MIT"
}
